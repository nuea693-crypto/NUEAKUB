            proL.Name="ProTag"
            proL.Size=UDim2.new(1,0,0,14); proL.Position=UDim2.new(0,0,0,17)
            proL.TextStrokeTransparency=0; proL.TextStrokeColor3=Color3.fromRGB(0,0,0)

            -- ถ้าเคยติดป้าย "โปร" มาก่อน (จำถาวร) ให้ขึ้นแดงทันทีไม่ต้องรอ heartbeat
            if getgenv().NUEAKUB_ProFlags[plr.UserId] then
                hl.FillColor=C.RED; hl.OutlineColor=C.RED; proL.Text="⚠ โปร"
            end

            return hl, proL
        end

        for _,plr in pairs(Players:GetPlayers()) do
            if plr~=LocalPlayer then
                if plr.Character then makeESP(plr.Character,plr) end
                ESPConns[plr]=plr.CharacterAdded:Connect(function(char) task.wait(0.5); if Features.ESP then makeESP(char,plr) end end)
            end
        end
        ESPConns["add"]=Players.PlayerAdded:Connect(function(plr)
            ESPConns[plr]=plr.CharacterAdded:Connect(function(char) task.wait(0.5); if Features.ESP then makeESP(char,plr) end end)
        end)

        -- Loop อัปเดตป้าย "โปร" + สีไฮไลท์แดงถ้าน่าสงสัย (จำถาวรตาม UserId)
        ESPConns["heartbeat"]=RunService.Heartbeat:Connect(function()
            if not Features.ESP then return end
            for _,plr in pairs(Players:GetPlayers()) do
                if plr~=LocalPlayer and plr.Character then
                    local char=plr.Character
                    UpdateProHeuristic(plr,char)
                    local isPro = getgenv().NUEAKUB_ProFlags[plr.UserId] == true
                    local hl=char:FindFirstChild("N_ESP")
                    local bg=char:FindFirstChild("N_ESP_LBL")
