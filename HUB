local function TrySubmitKey()
    if ValidateKey(kInput.Text) then
        SaveKeyToDisk(kInput.Text:upper():gsub("%s+",""))
        for _,d in pairs(KeyCard:GetDescendants()) do
            pcall(function()
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    Tw(d,0.15,{TextTransparency=1})
                end
                Tw(d,0.15,{BackgroundTransparency=1})
            end)
        end
        Tw(KeyCard,0.2,{BackgroundTransparency=1})
        Tw(KeyBG,0.25,{BackgroundTransparency=1})
        task.delay(0.35,function()
            KeyCard:Destroy(); KeyBG:Destroy()
            LoadBG.Visible   = true   -- ✅ ใช้ได้แล้ว
            LoadCard.Visible = true   -- ✅ ใช้ได้แล้ว
            task.spawn(RunLoad)
        end)
    else
        kErr.Text = "❌  คีย์ไม่ถูกต้อง หรือหมดอายุแล้ว"
        Tw(kInBG,0.1,{BackgroundColor3=Color3.fromRGB(55,18,18)})
        task.delay(0.35,function() Tw(kInBG,0.3,{BackgroundColor3=C.BG3}) end)
        task.delay(3,function() if kErr and kErr.Parent then kErr.Text="" end end)
    end
end

