-- ถ้ามีเจ้าของ ห้ามแตะเด็ดขาด กันไม่ให้ไปลากอาวุธออกจากมือคนอื่น
local function IsOwnedByPlayer(inst)
    if inst:FindFirstAncestorWhichIsA("Backpack") then return true end
    local model = inst:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then return true end
    return false
end

local function IsLikelyItem(inst)
    if not inst:IsA("BasePart") then return false end
    if IsOwnedByPlayer(inst) then return false end -- ← กันจุดที่เคยไปจับ Tool ที่คนอื่นถืออยู่

    -- ถ้าเป็นส่วนหนึ่งของ Tool ต้องเป็น Tool ที่ "ตกอยู่เฉยๆ ไม่มีเจ้าของ" เท่านั้น
    local toolAncestor = inst:FindFirstAncestorOfClass("Tool")
    if toolAncestor then
        local tp = toolAncestor.Parent
        local unclaimed = tp==workspace or (tp and (tp:IsA("Folder") or tp:IsA("Model")) and not Players:GetPlayerFromCharacter(tp))
        if unclaimed and inst.Name=="Handle" then
            return true
        end
        return false -- ส่วนอื่นของ Tool ที่ไม่ใช่ Handle ไม่เอา
    end

    local model = inst:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then return false end -- ไม่ใช่ NPC

    local n = inst.Name:lower()
    for _,kw in ipairs(ITEM_KEYWORDS) do
        if n:find(kw,1,true) then return true end
    end
    local p = inst.Parent
    if p then
        local pn = p.Name:lower()
        for _,kw in ipairs(ITEM_KEYWORDS) do
            if pn:find(kw,1,true) then return true end
        end
    end
    return false
end

local function RescanItems()
    table.clear(MagnetCache)
    for _,inst in ipairs(workspace:GetDescendants()) do
        if IsLikelyItem(inst) then
            table.insert(MagnetCache, inst)
        end
    end
end

task.spawn(function()
    while task.wait(0.6) do
        if MagnetOn then RescanItems() end
    end
end)

RunService.Heartbeat:Connect(function(dt)
    if not MagnetOn then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for i=#MagnetCache,1,-1 do
        local part = MagnetCache[i]
        if not part or not part.Parent then
            table.remove(MagnetCache,i)
        else
            local dist = (part.Position - root.Position).Magnitude
            if dist <= MagnetRadius then
                -- ดึงเข้าหาตัวเร็วขึ้นเรื่อยๆ ยิ่งใกล้ยิ่งไว
                part.CFrame = part.CFrame:Lerp(CFrame.new(root.Position), math.clamp(dt*6,0,1))
                -- ถ้าไอเทมมี ProximityPrompt (บางเกมใช้ระบบนี้เก็บของ) ลองยิงให้อัตโนมัติ
                local prompt = part:FindFirstChildOfClass("ProximityPrompt")
                if prompt and dist < 6 and typeof(fireproximityprompt)=="function" then
                    pcall(function() fireproximityprompt(prompt) end)
                end
            else
                table.remove(MagnetCache,i)
            end
        end
    end
end)

