if not getgenv().NUEAKUB_Keys then getgenv().NUEAKUB_Keys = {} end
local LIFETIME_KEY = "HACKROBLOX2027"
local CREATOR_PASS = "2327"

local function ValidateKey(raw)
    local key = (raw or ""):upper():gsub("%s+","")
    if key == LIFETIME_KEY then return true end
    local d = getgenv().NUEAKUB_Keys[key]
    if d and os.time() < d.expiry then return true end
    return false
end

local function GenerateDailyKey()
    local chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    local function seg(n)
        local s = ""
        for i = 1, n do local idx = math.random(1,#chars); s = s..chars:sub(idx,idx) end
        return s
    end
    local key = "NK-"..seg(4).."-"..seg(4)
    getgenv().NUEAKUB_Keys[key] = {expiry = os.time()+86400}
    return key
end

-- ============================================================
--  KEY MEMORY  (จำคีย์ข้ามเซสชั่น ใช้ writefile/readfile ถ้า executor รองรับ)
-- ============================================================
local KEY_SAVE_PATH = "NUEAKUB_key.txt"
local function SaveKeyToDisk(key)
    pcall(function()
        if writefile then writefile(KEY_SAVE_PATH, key) end
    end)
end
local function LoadKeyFromDisk()
    local ok, result = pcall(function()
        if isfile and readfile and isfile(KEY_SAVE_PATH) then
            return readfile(KEY_SAVE_PATH)
        end
        return nil
    end)
    if ok then return result end
    return nil
end

local function FormatTimeLeft(expiry)
    local s = math.max(0, expiry - os.time())
    return string.format("%dh %dm", math.floor(s/3600), math.floor((s%3600)/60))
end

