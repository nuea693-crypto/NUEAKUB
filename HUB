        local function makeESP(char,plr)
            local old=char:FindFirstChild("N_ESP"); if old then old:Destroy() end
            local oldLbl=char:FindFirstChild("N_ESP_LBL"); if oldLbl then oldLbl:Destroy() end

            -- Highlight ทั้งตัวแบบ 3D ไม่บังผู้เล่น (มองทะลุกำแพงได้แต่ไม่ทึบ)
