-- ============================================================
--  "โปร" (สงสัยใช้ hack) HEURISTIC TRACKER — จำถาวรตาม UserId
--  หมายเหตุ: อ่านจากตำแหน่งที่ขยับจริง (replicate มาให้ทุกคนเห็น)
--  เท่านั้น ไม่ใช่การอ่านค่า exploit ของอีกฝั่งโดยตรง — เป็นการ
--  ประมาณการ ไม่ใช่การตรวจจับที่แม่นยำ 100%
-- ============================================================
if not getgenv().NUEAKUB_ProFlags then getgenv().NUEAKUB_ProFlags = {} end -- [UserId]=true ถาวร ไม่มีวันรีเซ็ต
local ProTrack = {}  -- [plr] = {lastPos, lastTime, streak}  ← ใช้แค่คำนวณชั่วคราว
local PRO_SPEED_THRESHOLD = 55   -- studs/s แนวราบ (WalkSpeed ปกติ ~16)
local PRO_FLY_THRESHOLD   = 40   -- studs/s แนวดิ่งขณะไม่ตกอิสระ

local function UpdateProHeuristic(plr, char)
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    if getgenv().NUEAKUB_ProFlags[plr.UserId] then return end -- ติดป้ายแล้วไม่ต้องคำนวณซ้ำ
    local now = os.clock()
    local data = ProTrack[plr]
    if not data then
        ProTrack[plr] = {lastPos=root.Position, lastTime=now, streak=0}
        return
    end
    local dt = now - data.lastTime
    if dt < 0.15 then return end -- สุ่มตัวอย่างไม่ถี่เกินไปกันสั่น
    local delta = root.Position - data.lastPos
    local horizSpeed = Vector3.new(delta.X,0,delta.Z).Magnitude / dt
    local vertSpeed   = math.abs(delta.Y) / dt
    local isFreefall  = hum.FloorMaterial==Enum.Material.Air and hum:GetState()==Enum.HumanoidStateType.Freefall

    local flagged = false
    if horizSpeed > PRO_SPEED_THRESHOLD then flagged = true end
    if vertSpeed > PRO_FLY_THRESHOLD and not isFreefall then flagged = true end

    if flagged then
        data.streak = (data.streak or 0) + 1
    else
        data.streak = math.max(0, (data.streak or 0) - 1)
    end
    if data.streak >= 3 then
        getgenv().NUEAKUB_ProFlags[plr.UserId] = true -- ติดป้ายถาวร จำไปตลอด ไม่หลุด
    end
    data.lastPos = root.Position
    data.lastTime = now
end

