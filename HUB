                        if hl then hl.FillColor=C.WHITE; hl.OutlineColor=C.WHITE end
                        if proL then proL.Text="" end
                    end
                end
            end
        end)
    else
        for _,plr in pairs(Players:GetPlayers()) do
            if plr~=LocalPlayer and plr.Character then
                local h=plr.Character:FindFirstChild("N_ESP"); if h then h:Destroy() end
                local b=plr.Character:FindFirstChild("N_ESP_LBL"); if b then b:Destroy() end
            end
        end
        for k,c in pairs(ESPConns) do if typeof(c)=="RBXScriptConnection" then c:Disconnect() end; ESPConns[k]=nil end
