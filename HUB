-- 3. ฟังก์ชันระบบล่องหนมุดดิน (Underground Desync)
-- ==========================================
local function ToggleUnderground(enabled)
    State.Underground = enabled
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local root = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if enabled then
        -- เปิดการมุดดิน: ย้ายตัวละครลงใต้ดิน
        root.CFrame = root.CFrame + CONFIG.UndergroundOffset
        
        -- ล็อกมุมกล้องให้คงตำแหน่งบนพื้นดินไว้
        if humanoid then
            Camera.CameraSubject = FakeVisualPart
        end
    else
        -- ปิดการมุดดิน: วาร์ปตัวละครกลับมาตำแหน่งกล้องบนพื้นดินปัจจุบัน
        local returnPosition = FakeVisualPart.CFrame
        root.CFrame = returnPosition + Vector3.new(0, 3, 0)
        
        -- คืนค่ากล้องกลับสู่ตัวละครตามปกติ
        if humanoid then
            Camera.CameraSubject = humanoid
        end
    end
end

-- ==========================================
-- 4. Loop อัปเดตตำแหน่งกล้องและการเคลื่อนที่ (RenderStepped)
-- ==========================================
RunService.RenderStepped:Connect(function(deltaTime)
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        
        if State.Underground then
            -- อัปเดตตำแหน่งกล้องเสมือนให้อยู่บนพื้นดินตรงกับจุดที่เรายืน/บินใต้ดิน
            FakeVisualPart.CFrame = root.CFrame - CONFIG.UndergroundOffset
            
            -- ป้องกันไม่ให้ตกไปลึกเกินจนตาย (Safety Check against FallenPartsDestroyHeight)
            local minHeight = Workspace.FallenPartsDestroyHeight + 50
            if root.Position.Y < minHeight then
                root.CFrame = CFrame.new(root.Position.X, minHeight + 10, root.Position.Z)
            end
        end
        
        -- ทำงาน Anti-Aimbot
        if State.AntiAimbot then
            ApplyAntiAimbot()
        end
    end
end)

-- ==========================================
-- 5. ระบบช่วยวิถีกระสุน (Shooting Raycast Adapter)
-- ==========================================
-- ฟังก์ชันสำหรับเรียกใช้เวลากดคำสั่งยิง เพื่อให้กระสุนออกจากมุมมองกล้องบนดิน
local function GetShootingOrigin()
    if State.Underground then
        return FakeVisualPart.Position -- จุดยิงออกจากตำแหน่งบนดิน
    else
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("Head") then
            return character.Head.Position
        end
    end
    return Camera.CFrame.Position
end

-- ==========================================
-- 6. ตัวอย่างการเชื่อมต่อกับเมนู UI (Sidebar / Tabs)
-- ==========================================
-- สามารถนำฟังก์ชันเหล่านี้ไปผูกกับปุ่มในหมวดแถบซ้ายมือ "ล่องหน" ของคุณได้เลยครับ

local UI_Events = {}

-- เมื่อกดปุ่มสวิตช์ "กัน Aimbot"
function UI_Events.OnToggleAntiAimbot(booleanValue)
    State.AntiAimbot = booleanValue
end

-- เมื่อกดปุ่มสวิตช์ "ล่องหนมุดดิน" ในหมวดหมู่ [ล่องหน]
function UI_Events.OnToggleUnderground(booleanValue)
    ToggleUnderground(booleanValue)
end

return UI_Events
