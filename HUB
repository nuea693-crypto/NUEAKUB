            -- ป้ายชื่อ: ตัวหนังสือล้วน ไม่มีพื้นหลังบัง
            local bg=Instance.new("BillboardGui"); bg.Name="N_ESP_LBL"; bg.Size=UDim2.new(0,120,0,34)
