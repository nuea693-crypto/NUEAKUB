local function ResetSingleHitbox(plr)
    if plr and plr.Character then
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        local head = plr.Character:FindFirstChild("Head")

        if hrp then
            hrp.Size = Vector3.new(2, 2, 1)
            hrp.Transparency = 1
            hrp.Massless = false
        end
        if head then
            head.Size = Vector3.new(1.2, 1, 1.2)
            head.Transparency = 0
            head.Massless = false
        end
    end
end

-- ฟังก์ชันคืนค่าเดิมให้ทุกคน
local function ResetAllHitboxes()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            ResetSingleHitbox(plr)
        end
    end
end

-- 5. ลูปการทำงานหลัก (ย้ำสถานะตลอดเวลาเพื่อไม่ให้หลุด)
local function UpdateHitbox()
    if not hbSettings.Enabled then return end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            -- ตรวจสอบว่าเป็นเพื่อนหรือไม่ (เช็คจากตัวพิมพ์เล็ก/ใหญ่ให้อัตโนมัติ)
            local isFriend = false
            if hbSettings.FriendName ~= "" then
                -- ถ้าชื่อพิมพ์ตรงกับส่วนใดส่วนหนึ่งของชื่อผู้เล่น จะถือว่าเป็นเพื่อน
                if string.find(string.lower(plr.Name), string.lower(hbSettings.FriendName)) then
                    isFriend = true
                elseif string.find(string.lower(plr.DisplayName), string.lower(hbSettings.FriendName)) then
                    isFriend = true
                end
            end

            -- ถ้าเป็นเพื่อน ให้ข้ามไปและคืนค่า Hitbox ให้กลับเป็นปกติ
            if isFriend then
                ResetSingleHitbox(plr)
                continue
            end

            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local part = char:FindFirstChild(hbSettings.Target)

            if part and hum and hum.Health > 0 then
                part.Size = Vector3.new(hbSettings.Size, hbSettings.Size, hbSettings.Size)
                part.Transparency = hbSettings.Transparency
                part.Color = Color3.fromRGB(255, 255, 0)
                part.Material = Enum.Material.Neon
                
                -- ย้ำตลอดเวลาว่าห้ามชนและไม่มีน้ำหนัก เพื่อให้เราเดินทะลุได้ 100%
                part.CanCollide = false 
                part.Massless = true
            end

            -- คืนค่าชิ้นส่วนที่ไม่ได้เลือก
            local otherPartName = hbSettings.Target == "Head" and "HumanoidRootPart" or "Head"
            local otherPart = char:FindFirstChild(otherPartName)
            if otherPart then
                if otherPartName == "HumanoidRootPart" then
                    otherPart.Size = Vector3.new(2, 2, 1); otherPart.Transparency = 1
                else
                    otherPart.Size = Vector3.new(1.2, 1, 1.2); otherPart.Transparency = 0
                end
            end
        end
    end
end

